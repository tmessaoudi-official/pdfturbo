#!/usr/bin/env bash
# Pre-push gate — pushing to master auto-deploys to GitHub Pages with NO PR gate,
# and the test suite otherwise runs only in CI AFTER the push that already
# deployed. This hook runs the three FAST gates locally first — type-check, lint
# and the jsdom suite — so an obviously broken commit never reaches production.
#
# It is NOT "the exact CI gate", which this comment used to claim: CI also runs
# npm audit, ocr:assets, test:browser, test:coverage:export, build and qa:sweep.
# Those need a browser, network and several minutes, which is why they are not
# here — but it means a green hook is NOT a green deploy. Run the full gate from
# CLAUDE.md § Commands before a push you care about. [WS5 audit, 2026-09-04]
# Installed via the package.json "prepare" script
# (git config core.hooksPath .githooks); bypass in an emergency with
# `git push --no-verify`.
set -euo pipefail

echo "pre-push: running type-check + lint + test (CI gate)…"
npm run type-check
npm run lint
npm run test

echo "pre-push: gate passed."
