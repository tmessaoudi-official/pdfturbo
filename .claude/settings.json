{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(vitest:*)",
      "Bash(scripts/:*)",
      "Bash(bash scripts/:*)",
      "Bash(node scripts/:*)",
      "Bash(.githooks/:*)",
      "Bash(bash .githooks/:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(tree:*)",
      "Bash(xargs:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(fold:*)",
      "Bash(paste:*)",
      "Bash(comm:*)",
      "Bash(md5sum:*)",
      "Bash(sha256sum:*)",
      "Bash(base64:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(tar:*)",
      "Bash(gzip:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(perl:*)",
      "Bash(env:*)",
      "Bash(timeout:*)",
      "Bash(nproc:*)",
      "Bash(uname:*)",
      "Bash(command:*)",
      "Bash(which:*)",
      "Bash(compgen:*)",
      "Bash(test:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(sleep:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(curl:*)",
      "Bash(nohup:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__github"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxlint-on-write.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/locale-sync-check.sh"
          }
        ]
      }
    ]
  }
}
