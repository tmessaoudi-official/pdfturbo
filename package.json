{
  "name": "pdfturbo",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "PDFturbo — edit, annotate, sign and fill PDFs entirely in your browser",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "ocr:assets": "node scripts/prepare-ocr-assets.mjs",
    "pdfjs:assets": "node scripts/prepare-pdfjs-assets.mjs",
    "predev": "node scripts/prepare-ocr-assets.mjs && node scripts/prepare-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-ocr-assets.mjs && node scripts/prepare-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "pretest:browser": "node scripts/prepare-pdfjs-assets.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "qa:sweep": "node scripts/qa-sweep.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:export": "vitest run --config vitest.browser.config.ts --coverage tests/browser/pdfElementRenderer.browser.test.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "bidi-js": "1.1.0",
    "bwip-js": "^4.11.4",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "node-forge": "^1.4.3",
    "pdfjs-dist": "~6.3.289",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "^1.42.9",
    "qr-code-styling": "^1.9.2",
    "sortablejs": "^1.15.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/sortablejs": "^1.15.9",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2"
  }
}
