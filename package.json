{
  "name": "pdfturbo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PDFturbo — edit, annotate, sign and fill PDFs entirely in your browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "bwip-js": "^4.11.1",
    "docx": "^9.7.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "pdfjs-dist": "^6.0.0",
    "qr-code-styling": "^1.9.2",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/sortablejs": "^1.15.9",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
