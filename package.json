{
  "name": "pdfturbo",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "PDFturbo \u2014 edit, annotate, sign and fill PDFs entirely in your browser",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "ocr:assets": "node scripts/prepare-ocr-assets.mjs",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "qa:sweep": "node scripts/qa-sweep.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:export": "vitest run --config vitest.browser.config.ts --coverage tests/browser/pdfElementRenderer.browser.test.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "bidi-js": "1.0.3",
    "bwip-js": "^4.11.1",
    "docx": "^9.7.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^6.0.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "^1.41.9",
    "qr-code-styling": "^1.9.2",
    "sortablejs": "^1.15.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/sortablejs": "^1.15.9",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "axe-core": "^4.12.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5"
  }
}
