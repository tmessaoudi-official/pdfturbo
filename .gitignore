/.idea
/.playwright-mcp
/.superpowers
/node_modules
/dist
/.vite
# Vitest 5 consolidates its artifacts (attachments, failure screenshots, blob and html reports) here.
/.vitest
/coverage
/.claude/settings.local.json
/.claude/worktrees
# Black-box fidelity fixtures — real/confidential documents (C1/C2 but private,
# or personal/RGPD data). NEVER commit or push these. Used locally only to
# drive fidelity QA; committed regression tests use synthetic tests/fixtures/*.pdf.
/tests/fixtures/private/
# QA corpus: the large multi-MB arxiv sample stays local (5.1 MB binary, no code
# references it — used only for interactive sweeps). Small public-domain fixtures
# in corpus-public/ ARE committed for reproducibility.
/tests/fixtures/corpus-public/arxiv-multicol-japanese.pdf
# Safety net: never commit ad-hoc PDFs dropped in the repo root.
/*.pdf
# Vendored OCR assets (tesseract core wasm + worker + traineddata) — generated by
# scripts/prepare-ocr-assets.mjs (npm run ocr:assets). Kept out of git history;
# CI regenerates them before tests/build. See CLAUDE.md → "OCR (Sprint 4…)" for the
# CSP/engine constraints that force local serving.
/public/tesseract/
# …and WITHOUT the trailing slash too. A trailing-slash pattern matches a DIRECTORY only, so a
# SYMLINK named `public/tesseract` — the natural way to lend the assets to a git worktree, which
# has no copy of its own — was not ignored, got picked up by `git add -A`, and was committed as a
# mode-120000 entry that then replaced the real directory on checkout [2026-09-04].
/public/tesseract
# pdf.js's packed CMap files (CJK text encoded with a predefined Adobe CMap) — generated by
# scripts/prepare-pdfjs-assets.mjs (npm run pdfjs:assets) from node_modules; both spellings for the
# same symlink reason as above.
/public/pdfjs/
/public/pdfjs
# Local QA / visual-evidence screenshots — never committed (binary, ad-hoc).
# NOTE: because these are gitignored, a screenshot left here is evidence nobody will see —
# present it in the same turn (SendUserFile, or Read the PNG into the transcript).
/qa-shots/
# Claude runtime state: var/claude/{handoff,reports,sleuth,inspections,gaps,forge,memory,logs}
# written by the review skills and probes. Throwaway by design — local to this machine,
# never committed.
/var
# Belt-and-braces: never commit a copy of ~/.claude or ~/.claude.json. Those hold the
# OAuth account, userID and machineID. Nothing in this repo creates this directory (the
# container-era scripts/claude-bootstrap/ was removed 2026-08-18); the rule stays as defence.
/claude-bundle/
# Backups of .claude/settings.json (the developer's hand-over scripts make one) — never commit one.
/.claude/settings.json.bak.*

# Stray QA artifacts at the repo root. Reviewer probes and screenshots belong in var/claude/** (already
# ignored); this is the backstop so a `git add -A` on a green run cannot commit one. A root screenshot
# of a real document would be a content leak, not just noise.
/*.png
/*.tmp.mjs

# Throwaway in-container browser-test harness (hardcoded chromium path — never commit)
vitest.browser.container.ts

# Throwaway probe files from review rounds — never commit (they encode transient state).
tests/**/zz*

# npm writes here when NPM_CACHE_DIR is unset in the environment (an `env -i` run leaves the
# literal string unexpanded, so npm creates a directory named `${NPM_CACHE_DIR}`). Committed once
# by a `git add -A` in f85d37e; it carries debug logs with host paths and nothing the repo wants.
${NPM_CACHE_DIR}/
