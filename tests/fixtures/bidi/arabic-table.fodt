<table:table-row><table:table-cell table:style-name="TC"><text:p text:style-name="PR">النسخة</text:p></table:table-cell><table:table-cell table:style-name="TC"><text:p text:style-name="PR">برنامج PDFturbo الجديد</text:p></table:table-cell><table:table-cell table:style-name="TC"><text:p text:style-name="PL">The phrase مرحبا بكم here</text:p></table:table-cell></table:table-row>
